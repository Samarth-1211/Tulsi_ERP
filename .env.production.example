# Tulsi ERP backend — production settings for docker-compose.yml.
# (.env.example is the local-development template; this one is for the VPS.)
#
#   cp .env.production.example .env && chmod 600 .env     (on the server)
#
# Never commit .env. Values are read literally: no spaces around "=", no quotes
# needed, and avoid "$" in values (Compose treats it as a variable reference).
#
# IMPORTANT: leave an OPTIONAL setting commented out instead of blank. A blank
# line ("SMTP_PORT=") reaches the app as an empty string, which overrides the
# built-in default and can break login (JWT expiry) or email (SMTP port).
#
# Set by docker-compose.yml, do NOT add here: NODE_ENV, PORT, DATABASE_URL,
# UPLOADS_DIR, WEBHOOK_BASE_URL, TRUST_PROXY.

# ─── Domains & TLS (required) ───────────────────────────────────────────────
# API host name: bare name, no https://, no trailing slash. Needs a DNS A record
# pointing at the VPS (DNS only / grey cloud if the zone is on Cloudflare).
# WhatsApp/Meta webhook URLs become https://API_DOMAIN/webhooks/...
# The frontend must be built with VITE_API_URL=https://API_DOMAIN.
API_DOMAIN=api.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.com

# Frontend origin(s) on Cloudflare, comma-separated, exact (scheme + host, no
# trailing slash). The LAST entry is also used for links in emails, so put the
# main frontend URL last, e.g.:
#   CORS_ORIGINS=https://tulsi-erp.pages.dev,https://erp.example.com
CORS_ORIGINS=https://erp.example.com

# ─── PostgreSQL (required) ──────────────────────────────────────────────────
# Used to create the database on FIRST start and to build DATABASE_URL.
# Use URL-safe characters only:  openssl rand -hex 24
# Changing the password later does NOT change it inside an existing database —
# see DEPLOYMENT.md §8.1.
POSTGRES_USER=tulsi
POSTGRES_PASSWORD=replace-with-output-of-openssl-rand-hex-24
POSTGRES_DB=tulsi_erp

# ─── Auth (required) ────────────────────────────────────────────────────────
# At least 32 random characters:  openssl rand -hex 48
# Changing it signs everyone out.
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-hex-48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts each organization's stored WhatsApp tokens / App Secrets.
# Exactly 64 hex characters:  openssl rand -hex 32
# BACK IT UP. Losing or changing it makes stored WhatsApp credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-hex-32

# Super Admin created by the seed (docker compose exec backend node dist/prisma/seed.js).
# Password: 12+ characters. Re-running the seed resets the password to this value.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-unique-password

# Keep false in production: new users must verify their email.
AUTO_VERIFY_NEW_USERS=false

# ─── Email / SMTP (required for invites, verification and password reset) ──
# Gmail: SMTP_USER = full Gmail address, SMTP_PASS = 16-char App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=TDM Groups ERP
SMTP_FROM_EMAIL=your-address@gmail.com

# ─── Web Push (optional) ────────────────────────────────────────────────────
# Phone/browser notification-bar alerts. Generate ONCE and never change:
#   docker compose run --rm --no-deps backend npx web-push generate-vapid-keys
# Leave commented out to disable push (the in-app bell keeps working).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ─── Meta / WhatsApp (optional) ─────────────────────────────────────────────
# Per-organization WhatsApp credentials are entered in the app (Integrations
# page) and stored encrypted — they are not env vars. App-wide settings only:
# Fallback App Secret to verify webhook signatures when an org has not saved
# its own. With neither set, webhooks are accepted UNVERIFIED.
# META_APP_SECRET=
# hub.verify_token for GET /webhooks/meta/leadgen (Meta Lead Ads webhook).
# META_VERIFY_TOKEN=
# Lets the WhatsApp Debug Console check that THIS app is subscribed to the WABA.
# META_APP_ID=
# Graph API version (default v25.0).
# META_GRAPH_API_VERSION=v25.0
# Days to keep the raw webhook log (default 14).
# WHATSAPP_WEBHOOK_EVENT_RETENTION_DAYS=14
# "Simulate inbound webhook" debug tool: off in production unless true.
# WHATSAPP_DEBUG_SIMULATE_ENABLED=false

# ─── Misc (optional) ────────────────────────────────────────────────────────
# Publish Swagger at https://API_DOMAIN/api/docs (default: off in production).
# SWAGGER_ENABLED=false

# Days of backups scripts/backup.sh keeps in ./backups (default 14).
# BACKUP_RETENTION_DAYS=14

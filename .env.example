# PostgreSQL connection — a dedicated Tulsi database, never RCRM's.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wholeseler_erp?schema=public"

PORT=3000
NODE_ENV=development

# JWT access tokens (refresh tokens are opaque and stored hashed).
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"

# Seed script (prisma/seed.ts) creates ONLY the Super Admin; everything else is
# created from the Super Admin portal. The password is set from
# SUPERADMIN_PASSWORD on every seed run and is required (8+ chars, 12+ when
# NODE_ENV=production).
SUPERADMIN_EMAIL="superadmin@tulsi-erp.local"
SUPERADMIN_PASSWORD="choose-a-strong-unique-password"

# true = new users and orgs are created already verified (testing without SMTP).
# The invite email is still attempted. Set false in production.
AUTO_VERIFY_NEW_USERS=false

# SMTP (Gmail) — used by MailService to send org/team-member invite emails
# and password-reset OTPs. For Gmail, SMTP_USER is your full Gmail address
# and SMTP_PASS is a 16-character Google "App Password" (Google Account ->
# Security -> 2-Step Verification -> App Passwords), not your normal login
# password — Gmail rejects plain-password SMTP auth.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM_NAME="TDM Groups ERP"
SMTP_FROM_EMAIL="your-address@gmail.com"

# Comma-separated list of allowed CORS origins. Also doubles as the source
# of the frontend URL used to build links inside verification/invite emails
# (the last entry in the list is used, e.g. https://crm.example.com).
CORS_ORIGINS="http://localhost:5273"

# Optional: where uploaded project brochures are stored (a brochures/ folder is
# created inside it). Defaults to ./uploads; must be persistent storage.
# UPLOADS_DIR="/var/lib/crm/uploads"

# Web Push (browser / phone notification-bar alerts). Generate a pair once
# with `npx web-push generate-vapid-keys` and keep it stable — changing it
# invalidates every device's subscription. Leave blank to disable push (the
# in-app bell keeps working).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services — a mailto: or https: URL. Defaults to mailto:<SMTP_FROM_EMAIL>.
VAPID_SUBJECT=

# --- WhatsApp Cloud API (Meta) -------------------------------------------------
# Each organization's WhatsApp credentials (WABA ID, Phone Number ID, permanent
# System User access token, App Secret) are entered by that org's Admin on the
# Integrations page and stored ENCRYPTED in the database — they are not env vars,
# so one deployment can serve many organizations. Only app-wide settings live here.

# Public HTTPS origin of this backend, no trailing slash. The WhatsApp callback
# URL shown to admins is <WEBHOOK_BASE_URL>/webhooks/whatsapp/<per-org slug>.
# Meta cannot reach localhost — use your real domain or an ngrok/cloudflared URL.
WEBHOOK_BASE_URL="https://api.example.com"

# 32-byte key that encrypts stored access tokens and App Secrets.
# Generate with: openssl rand -hex 32   (changing it makes stored tokens unreadable)
CREDENTIALS_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Graph API version for every WhatsApp call (defaults to v25.0).
META_GRAPH_API_VERSION="v25.0"

# Fallback App Secret (Meta App Dashboard -> App settings -> Basic) used to verify
# the X-Hub-Signature-256 header on webhook POSTs when an org hasn't saved its own
# on the Integrations page. With neither set, webhooks are accepted UNVERIFIED.
META_APP_SECRET=

# hub.verify_token Meta echoes on GET /webhooks/meta/leadgen (native Lead Ads webhook).
META_VERIFY_TOKEN=

# Optional: your Meta App ID. Lets the WhatsApp Debug Console inspect tokens with
# an app token and confirm that THIS app (not just any app) is subscribed to the WABA.
META_APP_ID=

# Days to keep the raw webhook log (whatsapp_webhook_events). Default 14.
WHATSAPP_WEBHOOK_EVENT_RETENTION_DAYS=14

# The Debug Console's "Simulate inbound webhook" tool is on when NODE_ENV is not
# "production". Set to true to allow it anyway (staging), false to force it off.
WHATSAPP_DEBUG_SIMULATE_ENABLED=

# --- Maps (trip planner) — OpenStreetMap, no key needed ---------------------------
# Leave empty for the public servers (fine for an office's use). Point at your own
# instances if traffic grows. SMTP_FROM_EMAIL is sent as the contact OSM asks for.
NOMINATIM_URL=
PHOTON_URL=
OSRM_URL=

# --- Production hardening -------------------------------------------------------
# Number of reverse-proxy hops in front of the app (host Nginx = 1). Defaults to 1
# when NODE_ENV=production so rate limits and logs see the real client IP.
TRUST_PROXY=
# Publish Swagger at /api/docs. Default: on outside production, off in production.
SWAGGER_ENABLED=
